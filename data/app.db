ervisor:AUDIT","inputTokens":36383,"outputTokens":641,"cacheRead":2433,"cacheWrite":0,"costUsd":0.0039831300000000005,"cached":false,"ts":1793426207016},{"runId":"run_mvvzl4ex","model":"claude-haiku-5-5","purpose":"supervisor:AUDIT","inputTokens":38049,"outputTokens":156,"cacheRead":2433,"cacheWrite":0,"costUsd":0.00390723,"cached":false,"ts":1793426208458},{"runId":"run_mvvzl4ex","model":"claude-haiku-5-5","purpose":"supervisor:FINALIZE","inputTokens":39299,"outputTokens":1213,"cacheRead":0,"cacheWrite":2023,"costUsd":0.004789275,"cached":false,"ts":1793426213977}],"decisions":[{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129169,"input":{"line":"Senior Backend Engineer, Retrieval Platform"}},{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129176,"input":{"line":"We are building a retrieval platform."}},{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129186,"input":{"line":"You will own our vector search stack and the embeddings pipeline that feeds it, ship semantic search features, tune Postgres, write Python services, and lead API design for internal consumers."}},{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129194,"input":{"line":"Must have: vector search, Python, Postgres."}},{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129201,"input":{"line":"Nice to have: embeddings pipeline, API design."}},{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129208,"input":{"line":"Seniority: senior."}},{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"yes","confidence":0.95,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129208,"input":{"line":"Only female candidates under 28 from IIT or Northfield."}},{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"yes","confidence":0.95,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129208,"input":{"line":"Must be unmarried."}},{"runId":"run_mvvyf3nt","task":"injection_check","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130649,"input":{"text":"Hana Sharma. Backend Engineer with 5 years of experience in Retail.\nHana holds a MBA from St. Ada's College for Women. She would describe her strengths as: JavaScript, REST APIs, Unit Testing, CI/CD, OOP, Python.\nProjects: Rebuilt an event ingestion pipeline using REST APIs and OOP for an internal tools team. Built a billing service in OOP with REST APIs, and trimmed p95 latency by 40%.\nExperience: Delivered results using structured workflows and clear communication. Collaborated with stakeholders to define needs and execute tasks. Maintained reporting and documentation to support team performance."}},{"runId":"run_mvvyf3nt","task":"requirement_support","by":"local","label":"unsure","confidence":0.5,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130698,"input":{"sentence":"Experience: Delivered results using structured workflows and clear communication.","requirement":"vector search"}},{"runId":"run_mvvyf3nt","task":"requirement_support","by":"local","label":"unsure","confidence":0.5,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130711,"input":{"sentence":"Projects: Rebuilt an event ingestion pipeline using REST APIs and OOP for an internal tools team.","requirement":"Python"}},{"runId":"run_mvvyf3nt","task":"requirement_support","by":"local","label":"unsure","confidence":0.5,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130