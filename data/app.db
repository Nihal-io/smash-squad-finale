ude-haiku-5-5","purpose":"supervisor:SOURCE","inputTokens":39076,"outputTokens":700,"cacheRead":2737,"cacheWrite":0,"costUsd":0.00428497,"cached":false,"ts":1793425330250},{"runId":"run_mvvz3jjt","model":"claude-haiku-5-5","purpose":"supervisor:SOURCE","inputTokens":40490,"outputTokens":700,"cacheRead":2737,"cacheWrite":0,"costUsd":0.00442637,"cached":false,"ts":1793425334124}],"decisions":[{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129169,"input":{"line":"Senior Backend Engineer, Retrieval Platform"}},{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129176,"input":{"line":"We are building a retrieval platform."}},{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129186,"input":{"line":"You will own our vector search stack and the embeddings pipeline that feeds it, ship semantic search features, tune Postgres, write Python services, and lead API design for internal consumers."}},{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129194,"input":{"line":"Must have: vector search, Python, Postgres."}},{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129201,"input":{"line":"Nice to have: embeddings pipeline, API design."}},{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129208,"input":{"line":"Seniority: senior."}},{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"yes","confidence":0.95,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129208,"input":{"line":"Only female candidates under 28 from IIT or Northfield."}},{"runId":"run_mvvyf3nt","task":"discriminatory_clause","by":"local","label":"yes","confidence":0.95,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424129208,"input":{"line":"Must be unmarried."}},{"runId":"run_mvvyf3nt","task":"injection_check","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130649,"input":{"text":"Hana Sharma. Backend Engineer with 5 years of experience in Retail.\nHana holds a MBA from St. Ada's College for Women. She would describe her strengths as: JavaScript, REST APIs, Unit Testing, CI/CD, OOP, Python.\nProjects: Rebuilt an event ingestion pipeline using REST APIs and OOP for an internal tools team. Built a billing service in OOP with REST APIs, and trimmed p95 latency by 40%.\nExperience: Delivered results using structured workflows and clear communication. Collaborated with stakeholders to define needs and execute tasks. Maintained reporting and documentation to support team performance."}},{"runId":"run_mvvyf3nt","task":"requirement_support","by":"local","label":"unsure","confidence":0.5,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130698,"input":{"sentence":"Experience: Delivered results using structured workflows and clear communication.","requirement":"vector search"}},{"runId":"run_mvvyf3nt","task":"requirement_support","by":"local","label":"unsure","confidence":0.5,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130711,"input":{"sentence":"Projects: Rebuilt an event ingestion pipeline using REST APIs and OOP for an internal tools team.","requirement":"Python"}},{"runId":"run_mvvyf3nt","task":"requirement_support","by":"local","label":"unsure","confidence":0.5,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130727,"input":{"sentence":"Projects: Rebuilt an event ingestion pipeline using REST APIs and OOP for an internal tools team.","requirement":"Postgres"}},{"runId":"run_mvvyf3nt","task":"injection_check","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130728,"input":{"text":"Divya Lindqvist. Backend Engineer with 6 years of experience in FinTech.\nDivya holds a MSc from Oakridge Institute of Technology. She would describe her strengths as: Databases, Git, REST APIs, JavaScript, OOP, Docker.\nProjects: Wrote the REST APIs integration layer and its JavaScript test harness for a partner API. Designed an event ingestion pipeline using JavaScript and REST APIs for two product teams.\nExperience: Delivered results using structured workflows and clear communication. Collaborated with stakeholders to define needs and execute tasks. Maintained reporting and documentation to support team performance."}},{"runId":"run_mvvyf3nt","task":"requirement_support","by":"local","label":"unsure","confidence":0.5,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130781,"input":{"sentence":"Experience: Delivered results using structured workflows and clear communication.","requirement":"vector search"}},{"runId":"run_mvvyf3nt","task":"requirement_support","by":"local","label":"unsure","confidence":0.5,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130792,"input":{"sentence":"Projects: Wrote the REST APIs integration layer and its JavaScript test harness for a partner API.","requirement":"Python"}},{"runId":"run_mvvyf3nt","task":"requirement_support","by":"local","label":"unsure","confidence":0.5,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130805,"input":{"sentence":"Experience: Delivered results using structured workflows and clear communication.","requirement":"Postgres"}},{"runId":"run_mvvyf3nt","task":"injection_check","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130805,"input":{"text":"Omar Lindqvist. Backend Engineer with 1 years of experience in E-commerce.\nOmar holds a MSc from Carrow National Institute. He would describe his strengths as: REST APIs, Databases, Unit Testing, OOP, Python.\nProjects: Wrote the Python integration layer and its Unit Testing test harness for a partner API. Built an event ingestion pipeline using Unit Testing and Python for the platform group.\nExperience: Delivered results using structured workflows and clear communication. Collaborated with stakeholders to define needs and execute tasks. Maintained reporting and documentation to support team performance."}},{"runId":"run_mvvyf3nt","task":"requirement_support","by":"local","label":"unsure","confidence":0.5,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130853,"input":{"sentence":"Projects: Wrote the Python integration layer and its Unit Testing test harness for a partner API.","requirement":"vector search"}},{"runId":"run_mvvyf3nt","task":"requirement_support","by":"local","label":"unsure","confidence":0.5,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130864,"input":{"sentence":"Projects: Wrote the Python integration layer and its Unit Testing test harness for a partner API.","requirement":"Python"}},{"runId":"run_mvvyf3nt","task":"requirement_support","by":"local","label":"unsure","confidence":0.5,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130876,"input":{"sentence":"Built an event ingestion pipeline using Unit Testing and Python for the platform group.","requirement":"Postgres"}},{"runId":"run_mvvyf3nt","task":"injection_check","by":"local","label":"no","confidence":0.9,"costUsd":0,"counterfactualUsd":0.00009,"ts":1793424130877,"input":{"text":"Ishita Mehta. Backend Engineer with 9 years of experience in Retail. Former sorority treasurer.\nIshita holds a BA from Northfield Institute of Technology. She would describe her strengths as: Docker, Python, JavaScript, Git, REST APIs, Unit Testing, Java.\nProjects: Built an event ingestion pipeline using Docker and Unit Testing for an internal tools team. Migrated a monolith's order module to a standalone Unit Testing service with zero-downtime cutover.\nExperience: Delivered resul